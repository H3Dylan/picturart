# Copier en .env pour le développement local.

# Base embarquée (aucun Docker nécessaire), stockée dans apps/api/.data/
DATABASE_URL=pglite://./.data/dev
# … ou PostgreSQL via Docker (pnpm db:up) :
# DATABASE_URL=postgres://picturart:picturart@localhost:5432/picturart

PORT=3000
APP_ORIGIN=http://localhost:5173

# Compte de démo créé par `pnpm --filter @picturart/api seed:dev` (développement uniquement)
DEV_EMAIL=dev@picturart.local
DEV_PASSWORD=picturart-dev
